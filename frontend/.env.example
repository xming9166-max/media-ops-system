# 环境变量模板。
#
# 多环境约定（对应 Vite 的 mode）：
#   - .env.development  → 本地开发（npm run dev）
#   - .env.production   → 生产构建（npm run build）
#   - .env.test         → 测试（vitest）
# 复制本文件为对应环境的真实文件后按需修改；真实 .env.* 已被 .gitignore 忽略，
# 只有本模板入库。通用变量（如下）可放在任一环境文件中，同 key 会按 mode 覆盖。

# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:8000

# 请求超时（毫秒），缺省 15000
#VITE_API_TIMEOUT_MS=15000

# 前端日志级别：debug / info / warn / error / off，缺省 info
#VITE_LOG_LEVEL=info


#!/bin/sh
# pre-commit: backend ruff checks
# 由仓库根 .githooks/pre-commit 路由调用（仅 backend/** 变更时触发）
# activate: git config core.hooksPath .githooks
# bypass: git commit --no-verify

set -e

echo "backend pre-commit: ruff checks..."
.venv/bin/ruff format --check .
.venv/bin/ruff check .
echo "backend ruff passed"


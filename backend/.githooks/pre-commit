#!/bin/sh
# pre-commit: backend ruff + frontend lint
# activate: git config core.hooksPath backend/.githooks
# bypass: git commit --no-verify

set -e

echo "pre-commit: ruff checks..."
cd backend
.venv/bin/ruff format --check .
.venv/bin/ruff check .
echo "ruff passed"

cd ..
if [ -f frontend/package.json ]; then
  if [ -d frontend/node_modules ]; then
    echo "pre-commit: frontend lint..."
    (cd frontend && npm run lint)
    echo "frontend lint passed"
  else
    echo "skip frontend lint (no node_modules - run npm install)"
  fi
fi

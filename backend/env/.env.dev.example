# 开发环境配置模板（复制为 env/.env.dev 使用）
# dev 缺省即文件模式，自动读取 env/.env.dev

# 运行环境：dev / test / pro（缺省 dev）
#APP_ENV=dev

# 配置读取方式：file / env
# 缺省按环境推断：dev → file（读取 env/.env.dev）
#                test / pro → env（只读进程环境变量，不依赖文件）
#CONFIG_SOURCE=file

# 应用名
APP_NAME=media-ops-system

# 调试模式（true / false）
DEBUG=false

# API 路由前缀
API_V1_PREFIX=/api/v1

# 允许跨域的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]


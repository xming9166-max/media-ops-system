# 开发环境配置模板（复制为 env/.env.dev 使用）
# dev 缺省即文件模式，自动读取 env/.env.dev

# 运行环境：dev / test / pro（缺省 dev）
#APP_ENV=dev

# 配置读取方式：file / env
# 缺省按环境推断：dev → file（读取 env/.env.dev）
#                test / pro → env（只读进程环境变量，不依赖文件）
#CONFIG_SOURCE=file

# 应用名
APP_NAME=media-ops-system

# 调试模式（true / false）
DEBUG=false

# API 路由前缀
API_V1_PREFIX=/api/v1

# API 文档（Swagger UI）路径（默认 /docs，可自定义如 /api/v1/docs）
#API_DOCS_URL=/docs

# 服务监听配置（本地默认值；生产/部署通过环境变量注入）
#SERVER_HOST=127.0.0.1
#SERVER_PORT=8000

# 启动时是否打印配置信息（脱敏后输出，任何环境开启均安全）
#LOG_STARTUP_CONFIG=false

# 允许跨域的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 日志配置（未设置时按运行环境推断默认值，显式设置优先）
#LOG_ENABLED=true                    # 日志主开关；false 时项目 logger 不输出（不动全局 logging）
#LOG_OUTPUT=console                  # 输出位置：console / file / both（dev 默认 console）
#LOG_LEVEL=INFO                      # 日志级别：DEBUG / INFO / WARNING / ERROR
#LOG_DIR=logs                        # 文件输出目录（相对 backend/ 运行目录），FILE / BOTH 生效
#LOG_ACCESS_BODY=true                # 是否采样请求/响应 Body（dev 默认 true，生产默认 false）
#LOG_BODY_MAX_BYTES=4096             # Body 采样上限（字节），超出截断并打 truncated 标记
#LOG_SLOW_REQUEST_MS=1000            # 慢请求阈值（毫秒），超时访问日志升 WARNING 并打标；0 关闭
#LOG_TRUST_PROXY_HEADERS=false       # 是否信任 X-Forwarded-For 取客户端 IP（dev 默认 false，pro 默认 true）

# 数据库配置（dev 填本地 docker；缺省空串表示未启用数据库）
#MYSQL_DSN=mysql+pymysql://root:root@127.0.0.1:3306/media_ops
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
#DB_POOL_RECYCLE=3600
#DB_ECHO=false

# Redis 配置（dev 填本地 docker；缺省空串表示未启用 Redis）
#REDIS_URL=redis://127.0.0.1:6379/0

# JWT 配置（dev 可使用默认占位密钥；生产务必通过环境变量注入强随机密钥）
#JWT_SECRET=dev-secret-change-in-production-32bytes
#JWT_ALGORITHM=HS256
#JWT_EXPIRE_MINUTES=10080


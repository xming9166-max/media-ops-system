# 测试环境配置模板（复制为 env/.env.test 使用）
# 注意：test 缺省只读进程环境变量；仅当显式设置 CONFIG_SOURCE=file 时才读取本文件
# 运行环境：dev / test / pro（缺省 dev）

APP_ENV=test

# CONFIG_SOURCE=file

APP_NAME=media-ops-system

DEBUG=false

API_V1_PREFIX=/api/v1

# API 文档（Swagger UI）路径（默认 /docs，可自定义如 /api/v1/docs）
#API_DOCS_URL=/docs

# 服务监听配置（本地默认值；生产/部署通过环境变量注入）
#SERVER_HOST=127.0.0.1
#SERVER_PORT=8000

# 启动时是否打印配置信息（脱敏后输出，任何环境开启均安全）
#LOG_STARTUP_CONFIG=false

# 测试允许跨域的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 日志配置（未设置时按运行环境推断默认值，显式设置优先）
#LOG_ENABLED=true
#LOG_OUTPUT=file                     # 输出位置（test 默认 file，便于 CI 归档分析）
#LOG_LEVEL=INFO
#LOG_DIR=logs
#LOG_ACCESS_BODY=false
#LOG_BODY_MAX_BYTES=4096
#LOG_SLOW_REQUEST_MS=1000
#LOG_TRUST_PROXY_HEADERS=false

# Redis 配置（test 缺省只读进程环境变量；缺省空串表示未启用 Redis）
#REDIS_URL=

# JWT 配置（test 应注入独立密钥，避免与生产/开发混用）
#JWT_SECRET=test-secret
#JWT_ALGORITHM=HS256
#JWT_EXPIRE_MINUTES=10080

# 数据库配置（test 缺省只读进程环境变量；缺省空串表示未启用数据库）
#MYSQL_DSN=
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
#DB_POOL_RECYCLE=3600
#DB_ECHO=false


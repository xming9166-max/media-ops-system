# 测试环境配置模板（复制为 env/.env.test 使用）
# 注意：test 缺省只读进程环境变量；仅当显式设置 CONFIG_SOURCE=file 时才读取本文件
# 运行环境：dev / test / pro（缺省 dev）

APP_ENV=test

# CONFIG_SOURCE=file

APP_NAME=media-ops-system

DEBUG=false

API_V1_PREFIX=/api/v1

# 测试允许跨域的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 日志配置（未设置时按运行环境推断默认值，显式设置优先）
#LOG_ENABLED=true
#LOG_OUTPUT=file                     # 输出位置（test 默认 file，便于 CI 归档分析）
#LOG_LEVEL=INFO
#LOG_DIR=logs
#LOG_ACCESS_BODY=false
#LOG_BODY_MAX_BYTES=4096
#LOG_SLOW_REQUEST_MS=1000
#LOG_TRUST_PROXY_HEADERS=false

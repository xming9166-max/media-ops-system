# 生产环境配置模板（复制为 env/.env.pro 使用）
# 推荐：生产缺省只读进程环境变量（CONFIG_SOURCE 推断为 env），
# 仅当显式设置 CONFIG_SOURCE=file 时才读取本文件
# 禁止把真实密钥提交入库 —— 本模板只放占位值
APP_ENV=pro

#CONFIG_SOURCE=file

APP_NAME=media-ops-system

DEBUG=false

API_V1_PREFIX=/api/v1

# 生产允许跨域的前端来源（JSON 数组格式，替换为真实域名）
CORS_ORIGINS=["https://your-frontend-domain"]

# 日志配置（未设置时按运行环境推断默认值，显式设置优先）
#LOG_ENABLED=true
#LOG_OUTPUT=file                     # 输出位置：console / file / both（pro 默认 file）
#LOG_LEVEL=INFO
#LOG_DIR=logs
#LOG_ACCESS_BODY=false               # 是否采样 Body（pro 默认 false）
#LOG_BODY_MAX_BYTES=4096
#LOG_SLOW_REQUEST_MS=1000
#LOG_TRUST_PROXY_HEADERS=true        # pro 通常部署在反代后，信任 X-Forwarded-For

# 数据库配置（pro 缺省只读进程环境变量，由部署注入；缺省空串表示未启用数据库）
#MYSQL_DSN=
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
#DB_POOL_RECYCLE=3600
#DB_ECHO=false

